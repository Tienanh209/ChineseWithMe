# Copy to .env (docker compose) or backend/.env (running uvicorn directly).
# Every setting has a development default; prod refuses to start without SECRET_KEY.

ENV=dev                         # dev | test | prod  
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
# SECRET_KEY=                   # required in prod: 32+ random characters, e.g. `openssl rand -base64 48`
COOKIE_SECURE=false             # must be true in prod (HTTPS)
SESSION_TTL_DAYS=30
AUDIO_BASE_URL=/audio           # prod: https://<cdn>/audio
CORS_ORIGINS=[]                 # JSON list; empty when SPA and API share an origin
LOG_LEVEL=INFO
LOG_JSON=true

# Links in emails point here (Vite dev server by default, :8080 in docker compose)
PUBLIC_URL=http://localhost:5173
# Google sign-in: OAuth client ID (type "Web application") with the SPA origin as an
# authorised JavaScript origin. Empty hides the Google button.
GOOGLE_CLIENT_ID=
# console = log the message (dev), smtp = send (prod, Mailpit in compose), memory = tests
MAIL_BACKEND=console
MAIL_FROM=Học tiếng Trung <no-reply@localhost>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false

# golang-migrate (Makefile, CI)
MIGRATE_DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
